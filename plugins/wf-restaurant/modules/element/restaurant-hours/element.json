        "table_highlight_today": {
            "label": "Jour actuel",
            "type": "checkbox",
            "text": "Mettre en évidence aujourd'hui",
            "enable": "show_table"
        },
        "table_today_bg": {
            "label": "Fond aujourd'hui",
            "type": "text",
            "attrs": {
                "placeholder": "rgba(255,255,255,0.08)"
